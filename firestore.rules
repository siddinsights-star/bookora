rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection reachability probe
    match /test/connection {
      allow read: if true;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidStory(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'content']) &&
             data.keys().hasOnly(['id', 'userId', 'title', 'genre', 'tone', 'length', 'language', 'author', 'content', 'wordCount', 'updatedAt', 'createdAt', 'coverImage', 'imagePrompt', 'autoIllustrateEnabled', 'illustratedScenes', 'chapters', 'characters', 'worldLore', 'coverConfig', 'versionHistory', 'twists']) &&
             data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.title is string && data.title.size() <= 200 &&
             data.content is string && data.content.size() <= 1000000;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId) && isValidId(userId);
    }

    match /users/{userId}/stories/{storyId} {
      allow read: if isOwner(userId) && isValidId(storyId);
      
      allow create: if isOwner(userId) && 
                    isValidId(storyId) && 
                    isValidStory(request.resource.data) &&
                    request.resource.data.userId == userId;

      allow update: if isOwner(userId) && 
                    isValidId(storyId) && 
                    isValidStory(request.resource.data) &&
                    request.resource.data.userId == resource.data.userId &&
                    request.resource.data.id == resource.data.id;

      allow delete: if isOwner(userId) && isValidId(storyId);
    }
  }
}
