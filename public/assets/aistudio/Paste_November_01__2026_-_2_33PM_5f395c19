"server.js": r'''import "dotenv/config";
import express from "express";
import OpenAI from "openai";
import path from "path";
import { fileURLToPath } from "url";

const app = express();
const __dirname = path.dirname(fileURLToPath(import.meta.url));
app.use(express.json({ limit: "2mb" }));
app.use(express.static(path.join(__dirname, "public")));

const apiKey = process.env.OPENAI_API_KEY;
const openai = apiKey ? new OpenAI({ apiKey }) : null;
const TEXT_MODEL = process.env.TEXT_MODEL || "gpt-6-astra";
const IMAGE_MODEL = process.env.IMAGE_MODEL || "gpt-image-2.5-flare";

function requireAI(res) {
  if (!openai) {
    res.status(503).json({ error: "AI is not configured. Add OPENAI_API_KEY to your .env file and restart the server." });
    return false;
  }
  return true;
}

app.post("/api/story", async (req, res) => {
  if (!requireAI(res)) return;
  const { idea, genre = "Mystery", tone = "Cinematic", length = "Short" } = req.body || {};
  if (!idea?.trim()) return res.status(400).json({ error: "Please enter a story idea." });

  try {
    const response = await openai.responses.create({
      model: TEXT_MODEL,
      instructions: "You are a skilled fiction writer. Write original, coherent, engaging stories. Use a clear title, vivid scenes, believable characters, and a satisfying ending. Do not add commentary about the writing process.",
      input: `Write a ${length.toLowerCase()} ${genre} story in a ${tone.toLowerCase()} style based on this idea:\n${idea}`
    });
    res.json({ story: response.output_text || "" });
  } catch (err) {
    console.error("Story generation error:", err);
    res.status(500).json({ error: err.message || "Story generation failed." });
  }
});

app.post("/api/image", async (req, res) => {
  if (!requireAI(res)) return;
  const { story, scene = "", style = "cinematic digital storybook illustration" } = req.body || {};
  if (!story?.trim()) return res.status(400).json({ error: "Write or paste a story first." });

  try {
    const response = await openai.responses.create({
      model: TEXT_MODEL,
      instructions: "You are a visual story director. Read the story and create one detailed image-generation prompt for its most visually powerful scene. Preserve the story's actual characters, age range, clothing, setting, era, mood, and action. Do not invent contradictory plot details. Return only the image prompt, no explanation. Avoid written words, captions, logos, and watermarks in the image.",
      input: `Story:\n${story.slice(0, 12000)}\n\nSpecific scene (if supplied): ${scene || "Choose the strongest scene from the story."}\n\nVisual style: ${style}. Compose as a polished illustration suitable for a book page.`
    });

    const prompt = response.output_text?.trim();
    if (!prompt) throw new Error("Could not create an image prompt from the story.");

    const generated = await openai.images.generate({
      model: IMAGE_MODEL,
      prompt,
      size: "1024x1024",
      quality: "medium",
      output_format: "png",
      n: 1
    });

    const b64 = generated.data?.[0]?.b64_json;
    if (!b64) throw new Error("The image service returned no image.");
    res.json({ image: `data:image/png;base64,${b64}`, prompt });
  } catch (err) {
    console.error("Image generation error:", err);
    res.status(500).json({ error: err.message || "Image generation failed." });
  }
});

app.get("*", (_req, res) => {
  res.sendFile(path.join(__dirname, "public", "index.html"));
});

const port = Number(process.env.PORT || 3000);
app.listen(port, () => console.log(`STORYNEX is running at http://localhost:${port}`));
''',
