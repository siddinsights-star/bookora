"public/app.js": r'''const $ = (id) => document.getElementById(id);
let currentImage = "";
let toastTimer;

function toast(message) {
  const el = $("toast"); el.textContent = message; el.classList.add("show");
  clearTimeout(toastTimer); toastTimer = setTimeout(() => el.classList.remove("show"), 2800);
}
function getStories() { try { return JSON.parse(localStorage.getItem("storynex-stories") || "[]"); } catch { return []; } }
function setStories(stories) { localStorage.setItem("storynex-stories", JSON.stringify(stories)); }
function wordCount(text) { return text.trim() ? text.trim().split(/\s+/).length : 0; }
function updateCount() { $("wordCount").textContent = `${wordCount($("storyText").value)} words`; }
function currentStory() { return { id: window.currentStoryId || crypto.randomUUID(), title: $("storyTitle").value.trim() || "Untitled story", text: $("storyText").value, updated: new Date().toISOString() }; }

$("storyText").addEventListener("input", updateCount);
$("newStory").onclick = () => { window.currentStoryId = null; $("storyTitle").value = ""; $("storyText").value = ""; updateCount(); $("saveStatus").textContent = "New story ready"; currentImage = ""; $("imageResult").innerHTML = '<div class="image-placeholder"><span>✧</span><small>Your story illustration will appear here</small></div>'; $("downloadImage").classList.add("hidden"); showTab("editor"); };
$("saveStory").onclick = saveStory;
function saveStory() {
  const story = currentStory(); const stories = getStories();
  const index = stories.findIndex(s => s.id === story.id);
  if (index >= 0) stories[index] = story; else stories.unshift(story);
  setStories(stories); window.currentStoryId = story.id;
  $("saveStatus").textContent = "Saved just now"; toast("Story saved to your browser.");
}
$("refreshStories").onclick = renderLibrary;
$("focusEditor").onclick = () => { $("storyText").focus(); $("storyText").scrollIntoView({behavior:"smooth",block:"center"}); };
$("downloadTxt").onclick = downloadTxt;
function downloadTxt() {
  const text = `${$("storyTitle").value || "Untitled story"}\n\n${$("storyText").value}`;
  const blob = new Blob([text], {type:"text/plain;charset=utf-8"}); const a = document.createElement("a");
  a.href = URL.createObjectURL(blob); a.download = `${($("storyTitle").value || "story").replace(/[^a-z0-9-_]/gi,"_")}.txt`; a.click(); URL.revokeObjectURL(a.href);
}
$("insertChapter").onclick = () => insertAtCursor("\n\nChapter 1\n\n");
document.querySelectorAll("[data-insert]").forEach(btn => btn.onclick = () => insertAtCursor(btn.dataset.insert));
function insertAtCursor(value) { const t = $("storyText"); const start=t.selectionStart,end=t.selectionEnd; t.setRangeText(value,start,end,"end"); t.focus(); updateCount(); }

async function postJSON(url, data) {
  const response = await fetch(url, {method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(data)});
  const result = await response.json().catch(() => ({}));
  if (!response.ok) throw new Error(result.error || "Request failed.");
  return result;
}
$("generateStory").onclick = async () => {
  const idea = $("storyIdea").value.trim(); if (!idea) return toast("Write a story idea first.");
  const btn = $("generateStory"); btn.disabled = true; btn.textContent = "✦ Creating your story...";
  try {
    const result = await postJSON("/api/story", {idea,genre:$("genre").value,tone:$("tone").value,length:$("length").value});
    $("storyText").value = result.story; if (!$("storyTitle").value) $("storyTitle").value = result.story.split("\n").find(x=>x.trim())?.replace(/^#+\s*/,"").slice(0,100) || "AI Story";
    updateCount(); $("saveStatus").textContent = "AI story created — save when ready"; toast("Your story is ready!");
  } catch (e) { toast(e.message); }
